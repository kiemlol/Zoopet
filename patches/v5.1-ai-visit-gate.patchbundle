        typing.remove(); if (chatWith === d && dialog.open) { log.append(el('p', 'bot-msg', out)); log.scrollTop = log.scrollHeight; }
        const r = runs.get(d.id); if (r) r.say = { text: out, until: clock + 5 };
      }, 500 + rand() * 700);
    };
