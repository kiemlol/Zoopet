          else if (r.nextPlan <= 0) { r.nextPlan = 5 + rand() * 9; if (rand() < .3) sayLine(r, 'WANDER', 3200); else if (r.def.flies && rand() < .3) { r.mode = 'fly'; r.modeT = 6 + rand() * 4; w.speed = 6; r.flyY = FLY_HEIGHT; pickGoal(w, gardenCtx); } }
